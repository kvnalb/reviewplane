{
  "name": "@reviewplane/react",
  "version": "0.1.0",
  "description": "ReviewPlane overlay and WebMCP bridge for React apps",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
