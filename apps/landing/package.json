{
  "name": "@reviewplane/landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sandbox": "tsc -b && VITE_REVIEWPLANE_SANDBOX=true vite build",
    "preview": "vite preview",
    "preview:sandbox": "VITE_REVIEWPLANE_SANDBOX=true vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@reviewplane/react": "*",
    "@reviewplane/vite": "*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
